+static void ds4_offload_selftest_capture(const ds4_gpu_tensor *routed_out,
+                                         const ds4_gpu_tensor *router_selected,
+                                         const ds4_gpu_tensor *router_weights,
+                                         const ds4_gpu_tensor *ffn_norm, int il) {
